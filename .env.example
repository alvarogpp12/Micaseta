# Copia a .env y ajusta

# Puerto del servidor HTTP (solo local/VPS; en Vercel lo gestiona la plataforma)
PORT=3000
# URL pública (para los links mágicos del staff)
BASE_URL=http://localhost:3000

# Secreto para firmar QRs, links y sesiones. CAMBIAR en producción.
JWT_SECRET=cambiame-por-un-secreto-largo

# Teléfonos con rol admin (separados por coma). Solo dígitos con país.
ADMIN_PHONES=34649842031

# Prefijo de país por defecto al normalizar números de 9 dígitos (España)
DEFAULT_COUNTRY=34

# Proveedor de WhatsApp:
#   mock    → simulador en /dev (desarrollo)
#   cloud   → WhatsApp Business Cloud API oficial (producción / Vercel)
#   baileys → número personal vinculado (solo local/VPS, no sirve en Vercel)
WA_PROVIDER=mock

# Postgres (producción, p. ej. Supabase). Sin definir → PGlite local embebido
# en data/pglite. OJO: en Vercel sin esto la BD es EFÍMERA (se pierde en cada
# arranque en frío) — configúralo siempre en producción.
# Supabase → Project Settings → Database → Connection string (pooler, puerto 6543)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Login con Google (opcional). Google Cloud Console → Credentials →
# OAuth Client ID (Web) con tu dominio en "Authorized JavaScript origins".
# Sin definir, el botón de Google no se muestra.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Modo demo (/demo/camarero, /demo/puerta). Por defecto activo solo SIN
# DATABASE_URL, para no crear datos de prueba en producción. Forzar: 1/0
# DEMO_MODE=0

# Pases de Apple Wallet (.pkpass) — botón "Añadir a Apple Wallet" en la app.
# Requiere cuenta de Apple Developer: crea un "Pass Type ID" en
# developer.apple.com → Certificates, exporta el certificado y su clave en PEM,
# y descarga el certificado WWDR de Apple. Acepta PEM directo o en base64.
# Sin configurar, el botón simplemente no aparece.
# WALLET_PASS_TYPE_ID=pass.com.tucaseta.micaseta
# WALLET_TEAM_ID=ABCDE12345
# WALLET_CERT_PEM=LS0tLS1CRUdJTi... (base64 del .pem)
# WALLET_KEY_PEM=LS0tLS1CRUdJTi... (base64 del .pem de la clave)
# WALLET_KEY_PASSWORD=
# WALLET_WWDR_PEM=LS0tLS1CRUdJTi... (base64 del WWDR de Apple)

# WhatsApp Cloud API (solo WA_PROVIDER=cloud)
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_ID=123456789012345
# WHATSAPP_VERIFY_TOKEN=micaseta-verify

# Correo de bienvenida al registrar una caseta (Resend, resend.com — gratis).
# Sin API key no se envía nada. Con dominio propio verificado, cambia EMAIL_FROM.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Micaseta <hola@tudominio.com>
