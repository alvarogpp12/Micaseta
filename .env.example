# Copia a .env y ajusta

# Puerto del servidor HTTP (PWA staff + simulador dev)
PORT=3000
# URL pública del servidor (para los links mágicos del staff)
BASE_URL=http://localhost:3000

# Secreto para firmar QRs, links y sesiones. CAMBIAR en producción.
JWT_SECRET=cambiame-por-un-secreto-largo

# Teléfonos con rol admin (separados por coma). Solo dígitos con país.
# Ej: el número del dueño: 34649842031
ADMIN_PHONES=34649842031

# Prefijo de país por defecto al normalizar números de 9 dígitos (España)
DEFAULT_COUNTRY=34

# Proveedor de WhatsApp:
#   mock    → simulador en http://localhost:3000/dev (para desarrollo)
#   baileys → conecta tu número real (escanea el QR de vinculación en la terminal)
WA_PROVIDER=mock

# Ruta de la base de datos SQLite
DB_PATH=data/micaseta.db
