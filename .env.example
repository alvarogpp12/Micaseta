# Copia a .env y ajusta

# Puerto del servidor HTTP (solo local/VPS; en Vercel lo gestiona la plataforma)
PORT=3000
# URL pública (para los links mágicos del staff)
BASE_URL=http://localhost:3000

# Secreto para firmar QRs, links y sesiones. CAMBIAR en producción.
JWT_SECRET=cambiame-por-un-secreto-largo

# Teléfonos con rol admin (separados por coma). Solo dígitos con país.
ADMIN_PHONES=34649842031

# Prefijo de país por defecto al normalizar números de 9 dígitos (España)
DEFAULT_COUNTRY=34

# Proveedor de WhatsApp:
#   mock    → simulador en /dev (desarrollo)
#   cloud   → WhatsApp Business Cloud API oficial (producción / Vercel)
#   baileys → número personal vinculado (solo local/VPS, no sirve en Vercel)
WA_PROVIDER=mock

# Postgres (producción). Sin definir → PGlite local embebido en data/pglite
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# WhatsApp Cloud API (solo WA_PROVIDER=cloud)
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_ID=123456789012345
# WHATSAPP_VERIFY_TOKEN=micaseta-verify
